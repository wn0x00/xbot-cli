<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>false</UseAppHost>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ShadowBot.Common">
      <HintPath>$(ShadowBotDirectory)\ShadowBot.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ShadowBot.Runtime">
      <HintPath>$(ShadowBotDirectory)\ShadowBot.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ShadowBot.UIAutomation">
      <HintPath>$(ShadowBotDirectory)\ShadowBot.UIAutomation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
