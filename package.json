{
  "name": "@guanzhu.me/xbot-cli",
  "version": "0.7.3",
  "description": "Agent-friendly CLI for ShadowBot RPA applications, flows, tasks and browser automation",
  "license": "MIT",
  "author": "wn0x00",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wn0x00/xbot-cli.git"
  },
  "homepage": "https://github.com/wn0x00/xbot-cli#readme",
  "bugs": {
    "url": "https://github.com/wn0x00/xbot-cli/issues"
  },
  "keywords": [
    "xbot",
    "shadowbot",
    "rpa",
    "cli",
    "agent",
    "automation"
  ],
  "bin": {
    "xbot": "bin/xbot-cli.cjs",
    "xbot-cli": "bin/xbot-cli.cjs"
  },
  "files": [
    "bin/xbot-cli.cjs",
    "native/win32-x64/xbot-cli.exe"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "pretest": "npm run build",
    "test": "cargo test --locked && npm run test:npm && npm run test:skill",
    "test:npm": "node --test tests/npm/*.test.cjs",
    "test:skill": "node --test tests/skill/*.test.cjs",
    "test:package": "node scripts/test-package.cjs",
    "release:version": "node scripts/set-version.cjs",
    "prepack": "npm run build && node scripts/check-package.cjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
